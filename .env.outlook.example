# Second mailbox - Outlook
# Copy to .env.outlook: cp .env.outlook.example .env.outlook

IMAP_USER=your@outlook.com
IMAP_PASSWORD=your-app-password
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_TLS=true

# Outlook SMTP - NOTE: different from the defaults!
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@outlook.com
SMTP_PASSWORD=your-app-password
